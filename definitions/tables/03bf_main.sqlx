config {
    type: "incremental",
    schema: "ankit_raw",
    uniqueKey: ["MBLNR","MJAHR","ZEILE","BSTAUS"],
    tags: ["03bf_delta"]
}

SELECT
  *
FROM
  ${ref("03bfD_dacl")} ${when(incremental(), `WHERE CONCAT(MBLNR, '-', MJAHR, '-', ZEILE, '-', BSTAUS) NOT IN (SELECT CONCAT(MBLNR, '-', MJAHR, '-', ZEILE, '-', BSTAUS) FROM ${self()})`)}